# FDQH Environment Configuration
# 复制此文件为 .env，修改后保存

# 服务器端口
PORT=3000

# ========================================
# MongoDB 连接（三选一）
# ========================================

# 方式1: MongoDB Atlas 免费云数据库（推荐 → Railway + 本地同步）
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/fdqh?retryWrites=true&w=majority

# 方式2: 本地 MongoDB
# MONGODB_URI=mongodb://localhost:27017/fdqh

# 方式3: 不设置 → 自动使用 JSON 文件存储（无需数据库）

# ========================================
# AI 功能（可选）
# ========================================
# DASHSCOPE_API_KEY=sk-xxxxx
# DEEPSEEK_API_KEY=sk-xxxxx
